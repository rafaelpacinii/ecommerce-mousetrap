@startuml banco-de-dados
title E-commerce de mouses (MouseTrap) — modelo relacional 3NF implementado (V1–V9)
top to bottom direction
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam entityBackgroundColor #F5F9FF
skinparam entityBorderColor #355473

entity pais {
  * id : bigint <<PK, identity>>
  --
  * nome : varchar(100) <<UK>>
  * sigla_iso : varchar(2) <<UK>>
}

entity marca {
  * id : bigint <<PK, identity>>
  --
  pais_origem_id : bigint <<FK>>
  * nome : varchar(100) <<UK>>
  * ativo : boolean
  logomarca_url : varchar(2048)
  descricao : varchar(1000)
  site_oficial : varchar(500)
  email_suporte : varchar(254)
  ano_fundacao : integer
  * garantia_padrao_meses : integer
  * versao : bigint
}

entity sensor {
  * id : bigint <<PK, identity>>
  --
  * modelo : varchar(100) <<UK>>
  * fabricante : varchar(100)
  * dpi_maximo : integer
  * ips : integer
  * aceleracao_g : integer
  * ativo : boolean
  * versao : bigint
}

entity switch_mouse {
  * id : bigint <<PK, identity>>
  --
  * modelo : varchar(100) <<UK>>
  * fabricante : varchar(100)
  * tipo_switch : integer <<enum>>
  * durabilidade_milhoes_cliques : integer
  forca_atuacao_gf : numeric(5,1)
  * ativo : boolean
  * versao : bigint
}

entity mouse {
  * id : bigint <<PK, identity>>
  --
  * marca_id : bigint <<FK>>
  sensor_id : bigint <<FK>>
  switch_id : bigint <<FK>>
  * sku : varchar(50) <<UK>>
  * nome : varchar(150)
  * descricao : text
  * cor : varchar(50)
  * preco : numeric(12,2)
  * quantidade_estoque : integer
  * dpi_maximo : integer
  * quantidade_botoes : integer
  * peso_gramas : numeric(8,2)
  comprimento_mm : numeric(5,1)
  largura_mm : numeric(5,1)
  altura_mm : numeric(5,1)
  autonomia_bateria_horas : integer
  * garantia_meses : integer
  polling_rate : integer
  sensor : varchar(100)
  tipo_switch : integer <<enum>>
  modelo_switch : varchar(100)
  * ativo : boolean
  * versao : bigint
}

entity mouse_conexao <<tabela de coleção>> {
  * mouse_id : bigint <<PK, FK>>
  * tipo_conexao : integer <<PK, enum>>
}

entity mouse_pegada <<tabela de coleção>> {
  * mouse_id : bigint <<PK, FK>>
  * pegada : integer <<PK, enum>>
}

entity imagem_mouse {
  * id : bigint <<PK, identity>>
  --
  * mouse_id : bigint <<FK>>
  * url : varchar(2048)
  * texto_alternativo : varchar(150)
  * ordem : integer
  --
  UNIQUE (mouse_id, ordem)
}

entity estado {
  * id : bigint <<PK, identity>>
  --
  * nome : varchar(100)
  * sigla : varchar(2) <<UK>>
}

entity municipio {
  * id : bigint <<PK, identity>>
  --
  * estado_id : bigint <<FK>>
  * nome : varchar(120)
  * codigo_ibge : varchar(7) <<UK>>
}

entity cliente {
  * id : bigint <<PK, identity>>
  --
  * nome : varchar(100)
  * email : varchar(254) <<UK>>
  identidade_subject : varchar(255) <<UK>>
  cpf : varchar(11) <<UK>>
  data_nascimento : date
  * ativo : boolean
  * versao : bigint
}

entity telefone_cliente {
  * id : bigint <<PK, identity>>
  --
  * cliente_id : bigint <<FK>>
  * ddd : varchar(2)
  * numero : varchar(9)
  * tipo_telefone : integer <<enum>>
  * principal : boolean
  --
  UNIQUE (cliente_id, ddd, numero)
}

entity endereco {
  * id : bigint <<PK, identity>>
  --
  * cliente_id : bigint <<FK>>
  * municipio_id : bigint <<FK>>
  * apelido : varchar(60)
  * destinatario : varchar(100)
  * cep : varchar(8)
  * logradouro : varchar(200)
  * numero : varchar(20)
  complemento : varchar(100)
  * bairro : varchar(100)
  * principal : boolean
}

entity desejo {
  * id : bigint <<PK, identity>>
  --
  cliente_id : bigint <<FK>>
  * identidade_subject : varchar(255)
  * mouse_id : bigint <<FK>>
  --
  UNIQUE (identidade_subject, mouse_id)
}

entity transportadora {
  * id : bigint <<PK, identity>>
  --
  * nome : varchar(100) <<UK>>
  cnpj : varchar(14) <<UK>>
  url_rastreio_padrao : varchar(500)
  * valor_base_frete : numeric(12,2)
  * prazo_medio_dias : integer
  * ativo : boolean
  * versao : bigint
}

entity pedido {
  * id : bigint <<PK, identity>>
  --
  * cliente_id : bigint <<FK>>
  transportadora_id : bigint <<FK>>
  * chave_checkout : uuid <<UK>>
  * requisicao_hash : varchar(64)
  * status : integer <<enum>>
  * criado_em : timestamptz
  * expira_em : timestamptz
  * frete : numeric(12,2)
  * prazo_dias_uteis : integer
  * versao : bigint
  transportadora : varchar(80)
  codigo_rastreio : varchar(64)
  enviado_em : timestamptz
  entregue_em : timestamptz
  --
  * entrega_destinatario : varchar(100)
  * entrega_cep : varchar(8)
  * entrega_logradouro : varchar(200)
  * entrega_numero : varchar(20)
  entrega_complemento : varchar(100)
  * entrega_bairro : varchar(100)
  * entrega_municipio : varchar(120)
  * entrega_uf : char(2)
}

entity item_pedido {
  * id : bigint <<PK, identity>>
  --
  * pedido_id : bigint <<FK>>
  * mouse_id : bigint <<FK>>
  * sku : varchar(50)
  * nome : varchar(150)
  * cor : varchar(50)
  * marca : varchar(100)
  * quantidade : integer
  * preco_unitario : numeric(12,2)
  --
  UNIQUE (pedido_id, mouse_id)
}

entity pagamento {
  * id : bigint <<PK, identity>>
  --
  * pedido_id : bigint <<FK>>
  * chave_idempotencia : uuid <<UK>>
  * forma : integer <<enum>>
  * status : integer <<enum>>
  * resultado_simulado : integer <<enum>>
  * valor : numeric(12,2)
  * versao : bigint
  processado_em : timestamptz
}

entity evento_pedido {
  * id : bigint <<PK, identity>>
  --
  * pedido_id : bigint <<FK>>
  * status : integer <<enum>>
  * ocorrido_em : timestamptz
  * descricao : varchar(160)
  responsavel_subject : varchar(255)
}

pais ||--o{ marca : origem
marca ||--o{ mouse : fabrica
sensor ||--o{ mouse : equipa
switch_mouse ||--o{ mouse : aciona
mouse ||--|{ mouse_conexao : suporta
mouse ||--o{ mouse_pegada : indica
mouse ||--o{ imagem_mouse : apresenta
estado ||--|{ municipio : pertence
cliente ||--o{ telefone_cliente : contatos
cliente ||--o{ endereco : cadastra
municipio ||--o{ endereco : localiza
cliente ||--o{ desejo : favorita
mouse ||--o{ desejo : desejado
cliente ||--o{ pedido : realiza
transportadora ||--o{ pedido : entrega
pedido ||--|{ item_pedido : contém
mouse ||--o{ item_pedido : referencia
pedido ||--o{ pagamento : tentativas
pedido ||--|{ evento_pedido : registra

legend left
  * = NOT NULL; sem * = aceita NULL.
  PK = chave primária; FK = chave estrangeira; UK = UNIQUE.
  Todas as tabelas com id herdam de DefaultEntity:
    data_cadastro timestamp NOT NULL
    data_alteracao timestamp NULL
  Modelo normalizado em 3NF até a migração Flyway V9.
endlegend
@enduml
