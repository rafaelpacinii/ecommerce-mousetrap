# ===================================================================
# Conexão com o Banco de Dados PostgreSQL
# ===================================================================
quarkus.datasource.db-kind=postgresql
quarkus.datasource.username=dbuser
quarkus.datasource.password=dbpasswd
quarkus.datasource.jdbc.url=jdbc:postgresql://localhost:5432/db

# Flyway cria o catálogo uma vez; Hibernate apenas verifica o esquema.
quarkus.flyway.migrate-at-start=true
quarkus.hibernate-orm.schema-management.strategy=validate
quarkus.hibernate-orm.sql-load-script=no-file

# Desabilita o DevServices (pois usamos container Docker ou PostgreSQL local explícito)
quarkus.devservices.enabled=false

# Exibir comandos SQL no console para depuração
quarkus.hibernate-orm.log.sql=true
quarkus.hibernate-orm.log.bind-parameters=false

# ===================================================================
# Configuração de CORS (comunicação com Angular em localhost:4200)
# ===================================================================
quarkus.http.cors.enabled=true
quarkus.http.cors.origins=http://localhost:4200
quarkus.http.cors.methods=GET,PUT,POST,DELETE,PATCH,OPTIONS
quarkus.http.cors.headers=accept, authorization, content-type, x-requested-with
quarkus.http.cors.exposed-headers=Authorization, Content-Disposition, X-Page, X-Page-Size, X-Total-Count
quarkus.http.cors.access-control-max-age=24H
quarkus.http.cors.access-control-allow-credentials=true

# Base URL para RFC-7807 (Tratamento de problemas e erros)
%dev.problem.base-url=http://localhost:8080

# Consulta externa de CEP (timeout: conexão 5s, requisição 8s).
viacep.url=https://viacep.com.br/ws/
