# Local development only. Copy to application.properties and adjust privately.
# Never commit the active file. Release builds must use -Prelease with clean.
quarkus.datasource.db-kind=postgresql
quarkus.datasource.username=dbuser
quarkus.datasource.password=dbpasswd
quarkus.datasource.jdbc.url=jdbc:postgresql://localhost:5432/db

# Flyway applies incremental migrations; Hibernate only validates the schema.
quarkus.flyway.migrate-at-start=true
quarkus.hibernate-orm.schema-management.strategy=validate
quarkus.hibernate-orm.sql-load-script=no-file
quarkus.devservices.enabled=false
quarkus.hibernate-orm.log.sql=false
quarkus.hibernate-orm.log.bind-parameters=false

# Public browser origin. For releases, shared defaults read WEB_ORIGIN.
quarkus.http.cors.enabled=true
quarkus.http.cors.origins=http://localhost:4200
quarkus.http.cors.methods=GET,PUT,POST,DELETE,PATCH,OPTIONS
quarkus.http.cors.headers=accept,authorization,content-type,x-requested-with
quarkus.http.cors.exposed-headers=X-Page,X-Page-Size,X-Total-Count,Content-Disposition
quarkus.http.cors.access-control-allow-credentials=true
quarkus.http.limits.max-body-size=6M
%dev.problem.base-url=http://localhost:8080

# External postcode lookup and configurable delivery estimates.
viacep.url=https://viacep.com.br/ws/
frete.valor-padrao=29.90
frete.prazo-dias-uteis=5

# Identity defaults also apply through META-INF/microprofile-config.properties.
quarkus.oidc.auth-server-url=${OIDC_AUTH_SERVER_URL:http://localhost:8180/realms/mousetrap}
quarkus.oidc.client-id=mousetrap-api
quarkus.oidc.application-type=service
quarkus.oidc.token.audience=mousetrap-api
quarkus.oidc.roles.role-claim-path=realm_access/roles
quarkus.oidc.token.allow-jwt-introspection=false
quarkus.oidc.token.allow-opaque-token-introspection=false
quarkus.security.jaxrs.deny-unannotated-endpoints=true

# Explicit opt-in outside dev/test; never enable for actual financial settlement.
pagamentos.simulacao.habilitada=false
%dev.pagamentos.simulacao.habilitada=true
%test.pagamentos.simulacao.habilitada=true
pedidos.prazo-pagamento-minutos=30
pedidos.expiracao.intervalo=30s

# Catalog uploads: credentials stay on the API. Public URLs are served directly by R2.
storage.r2.enabled=${R2_ENABLED:false}
storage.r2.endpoint=${R2_ENDPOINT:}
storage.r2.bucket=${R2_BUCKET:}
storage.r2.access-key-id=${R2_ACCESS_KEY_ID:}
storage.r2.secret-access-key=${R2_SECRET_ACCESS_KEY:}
storage.r2.public-url=${R2_PUBLIC_URL:}
