@startuml banco-de-dados
title E-commerce de mouses (MouseTrap) — modelo relacional 3NF completo (implementado V1–V9 | planejado V11–V16)
top to bottom direction
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam class {
  BackgroundColor #F5F9FF
  BorderColor #355473
  BackgroundColor<<Planned>> #FFFBEB
  BorderColor<<Planned>> #B45309
  BackgroundColor<<Collection>> #EEFDF4
  BorderColor<<Collection>> #15803D
}

entity pais {
  * id : bigint <<PK, identity>>
  --
  * nome : varchar(100) <<UK>>
  * sigla_iso : varchar(2) <<UK>>
}

entity marca {
  * id : bigint <<PK, identity>>
  --
  pais_origem_id : bigint <<FK>>
  * nome : varchar(100) <<UK, UK lower(nome)>>
  * ativo : boolean
  logomarca_url : varchar(2048)
  descricao : varchar(1000)
  site_oficial : varchar(500)
  email_suporte : varchar(254)
  ano_fundacao : integer
  * garantia_padrao_meses : integer
  * versao : bigint
}

entity categoria <<Planned>> {
  * id : bigint <<PK, identity>> [V11]
  --
  * nome : varchar(100) <<UK, UK lower(nome)>> [V11]
  * slug : varchar(120) <<UK>> [V11]
  descricao : varchar(500) [V11]
  * ativo : boolean [V11]
  * versao : bigint [V11]
}

entity sensor {
  * id : bigint <<PK, identity>>
  --
  * modelo : varchar(100) <<UK, UK lower(modelo)>>
  * fabricante : varchar(100)
  * dpi_maximo : integer
  * ips : integer
  * aceleracao_g : integer
  * ativo : boolean
  * versao : bigint
}

entity switch_mouse {
  * id : bigint <<PK, identity>>
  --
  * modelo : varchar(100) <<UK, UK lower(modelo)>>
  * fabricante : varchar(100)
  * tipo_switch : integer <<enum>>
  * durabilidade_milhoes_cliques : integer
  forca_atuacao_gf : numeric(5,1)
  * ativo : boolean
  * versao : bigint
}

entity mouse {
  * id : bigint <<PK, identity>>
  --
  * marca_id : bigint <<FK>>
  sensor_id : bigint <<FK>>
  switch_id : bigint <<FK>>
  categoria_id : bigint <<FK>> [Planejado V11]
  * sku : varchar(50) <<UK>>
  * nome : varchar(150)
  * descricao : text
  * cor : varchar(50)
  * preco : numeric(12,2)
  * quantidade_estoque : integer
  * dpi_maximo : integer
  * quantidade_botoes : integer
  * peso_gramas : numeric(8,2)
  comprimento_mm : numeric(5,1)
  largura_mm : numeric(5,1)
  altura_mm : numeric(5,1)
  autonomia_bateria_horas : integer
  * garantia_meses : integer
  polling_rate : integer
  sensor : varchar(100) <<legado V3>>
  tipo_switch : integer <<enum, legado V3>>
  modelo_switch : varchar(100) <<legado V3>>
  * ativo : boolean
  * versao : bigint
  --
  * destaque : boolean [Planejado V12]
  ordem_destaque : integer [Planejado V12]
  * preco_centavos : bigint [Planejado V16]
}

entity mouse_conexao <<Collection>> {
  * mouse_id : bigint <<PK, FK>>
  * tipo_conexao : integer <<PK, enum>>
}

entity mouse_pegada <<Collection>> {
  * mouse_id : bigint <<PK, FK>>
  * pegada : integer <<PK, enum>>
}

entity imagem_mouse {
  * id : bigint <<PK, identity>>
  --
  * mouse_id : bigint <<FK>>
  * url : varchar(2048)
  * texto_alternativo : varchar(200)
  * ordem : integer
  --
  UNIQUE (mouse_id, ordem)
}

entity estado {
  * id : bigint <<PK, identity>>
  --
  * nome : varchar(100)
  * sigla : varchar(2) <<UK>>
}

entity municipio {
  * id : bigint <<PK, identity>>
  --
  * estado_id : bigint <<FK>>
  * nome : varchar(150)
  * codigo_ibge : varchar(7) <<UK>>
}

entity cliente {
  * id : bigint <<PK, identity>>
  --
  * nome : varchar(100)
  * email : varchar(254) <<UK>>
  identidade_subject : varchar(255) <<UK>>
  cpf : varchar(11) <<UK>>
  data_nascimento : date
  * ativo : boolean
  * versao : bigint
  --
  cep : varchar(8) <<legado V2>>
  logradouro : varchar(200) <<legado V2>>
  bairro : varchar(100) <<legado V2>>
  numero : varchar(20) <<legado V2>>
  complemento : varchar(100) <<legado V2>>
  municipio_id : bigint <<FK, legado V2>>
}

entity telefone_cliente {
  * id : bigint <<PK, identity>>
  --
  * cliente_id : bigint <<FK>>
  * ddd : varchar(2)
  * numero : varchar(9)
  * tipo_telefone : integer <<enum>>
  * principal : boolean
  --
  UNIQUE (cliente_id, ddd, numero)
}

entity endereco {
  * id : bigint <<PK, identity>>
  --
  * cliente_id : bigint <<FK>>
  * municipio_id : bigint <<FK>>
  * apelido : varchar(60)
  * destinatario : varchar(150)
  * cep : varchar(8)
  * logradouro : varchar(200)
  * numero : varchar(20)
  complemento : varchar(100)
  * bairro : varchar(100)
  * principal : boolean
  --
  UNIQUE (cliente_id) WHERE principal = true
}

entity desejo {
  * id : bigint <<PK, identity>>
  --
  cliente_id : bigint <<FK>>
  * identidade_subject : varchar(255)
  * mouse_id : bigint <<FK>>
  --
  UNIQUE (identidade_subject, mouse_id)
}

entity transportadora {
  * id : bigint <<PK, identity>>
  --
  * nome : varchar(100) <<UK, UK lower(nome)>>
  cnpj : varchar(14) <<UK>>
  url_rastreio_padrao : varchar(500)
  * valor_base_frete : numeric(12,2)
  * prazo_medio_dias : integer
  * ativo : boolean
  * versao : bigint
}

entity cupom <<Planned>> {
  * id : bigint <<PK, identity>> [V13]
  --
  * codigo : varchar(40) <<UK>> [V13]
  descricao : varchar(300) [V13]
  * tipo_desconto : integer <<enum>> [V13]
  * valor_desconto : numeric(12,2) [V13]
  * valor_minimo_pedido : numeric(12,2) [V13]
  limite_usos : integer [V13]
  * quantidade_usada : integer [V13]
  * valido_de : timestamptz [V13]
  * valido_ate : timestamptz [V13]
  * ativo : boolean [V13]
  * versao : bigint [V13]
}

entity pedido {
  * id : bigint <<PK, identity>>
  --
  * cliente_id : bigint <<FK>>
  transportadora_id : bigint <<FK>>
  cupom_id : bigint <<FK>> [Planejado V13]
  * chave_checkout : uuid <<UK>>
  * requisicao_hash : varchar(64)
  * status : integer <<enum>>
  * criado_em : timestamptz
  * expira_em : timestamptz
  * frete : numeric(12,2)
  * prazo_dias_uteis : integer
  * versao : bigint
  transportadora : varchar(100) <<snapshot>>
  codigo_rastreio : varchar(80)
  enviado_em : timestamptz
  entregue_em : timestamptz
  --
  codigo_cupom : varchar(40) [Planejado V13]
  * valor_desconto : numeric(12,2) [Planejado V13]
  estornado_em : timestamptz [Planejado V15]
  motivo_estorno : varchar(300) [Planejado V15]
  --
  * entrega_destinatario : varchar(150)
  * entrega_cep : varchar(8)
  * entrega_logradouro : varchar(200)
  * entrega_numero : varchar(20)
  entrega_complemento : varchar(100)
  * entrega_bairro : varchar(100)
  * entrega_municipio : varchar(150)
  * entrega_uf : varchar(2)
}

entity item_pedido {
  * id : bigint <<PK, identity>>
  --
  * pedido_id : bigint <<FK>>
  * mouse_id : bigint <<FK>>
  * sku : varchar(50)
  * nome : varchar(150)
  * cor : varchar(50)
  * marca : varchar(100)
  * quantidade : integer
  * preco_unitario : numeric(12,2)
  --
  UNIQUE (pedido_id, mouse_id)
}

entity pagamento {
  * id : bigint <<PK, identity>>
  --
  * pedido_id : bigint <<FK>>
  * chave_idempotencia : uuid <<UK>>
  * forma : integer <<enum>>
  * status : integer <<enum>>
  * resultado_simulado : integer <<enum>>
  * valor : numeric(18,2)
  * versao : bigint
  processado_em : timestamptz
  --
  provedor : varchar(60) [Planejado V16]
  transacao_externa_id : varchar(120) [Planejado V16]
  --
  UNIQUE (pedido_id) WHERE status IN (1, 2)
}

entity evento_pedido {
  * id : bigint <<PK, identity>>
  --
  * pedido_id : bigint <<FK>>
  * status : integer <<enum>>
  * ocorrido_em : timestamptz
  * descricao : varchar(200)
  responsavel_subject : varchar(255)
}

entity avaliacao <<Planned>> {
  * id : bigint <<PK, identity>> [V14]
  --
  * mouse_id : bigint <<FK>> [V14]
  * cliente_id : bigint <<FK>> [V14]
  * pedido_id : bigint <<FK>> [V14]
  * nota : integer [V14]
  titulo : varchar(120) [V14]
  comentario : varchar(2000) [V14]
  * visivel : boolean [V14]
  * versao : bigint [V14]
  --
  UNIQUE (cliente_id, mouse_id) [V14]
}

entity evento_webhook_pagamento <<Planned>> {
  * id : bigint <<PK, identity>> [V16]
  --
  pagamento_id : bigint <<FK>> [V16]
  * provedor : varchar(60) [V16]
  * evento_externo_id : varchar(120) [V16]
  * tipo_evento : varchar(80) [V16]
  * payload_hash : varchar(64) [V16]
  * status_processamento : varchar(40) [V16]
  * processado_em : timestamptz [V16]
  --
  UNIQUE (provedor, evento_externo_id) [V16]
}

pais |o--o{ marca : origem
marca ||--o{ mouse : fabrica
categoria |o..o{ mouse : classifica [V11]
sensor |o--o{ mouse : equipa
switch_mouse |o--o{ mouse : aciona
mouse ||--|{ mouse_conexao : suporta
mouse ||--o{ mouse_pegada : indica
mouse ||--o{ imagem_mouse : apresenta
estado ||--|{ municipio : pertence
municipio |o--o{ cliente : legado_v2
cliente ||--o{ telefone_cliente : contatos
cliente ||--o{ endereco : cadastra
municipio ||--o{ endereco : localiza
cliente |o--o{ desejo : favorita
mouse ||--o{ desejo : desejado
cliente ||--o{ pedido : realiza
transportadora |o--o{ pedido : entrega
cupom |o..o{ pedido : desconta [V13]
pedido ||--|{ item_pedido : contém
mouse ||--o{ item_pedido : referencia
pedido ||--o{ pagamento : tentativas
pedido ||--|{ evento_pedido : registra
pagamento |o..o{ evento_webhook_pagamento : reconcilia [V16]
cliente ||..o{ avaliacao : publica [V14]
mouse ||..o{ avaliacao : avaliado [V14]
pedido ||..o{ avaliacao : comprova [V14]

legend left
  * = NOT NULL; sem * = aceita NULL.
  PK = chave primária; FK = chave estrangeira; UK = UNIQUE.
  Azul = Tabelas 3NF implementadas nas migrações Flyway V1–V9.
  Âmbar (<<Planned>> e campos [Planejado V11–V16]) = Evolução relacional aprovada no ROADMAP (v1.2.0 → v2.0.0).
  Verde (<<Collection>>) = Tabelas de coleção sem id artificial nem herança de DefaultEntity.
  Todas as demais tabelas possuem colunas herdadas de DefaultEntity:
    data_cadastro timestamp NOT NULL
    data_alteracao timestamp NULL
endlegend
@enduml
