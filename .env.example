# ===================================================================
# MouseTrap E-Commerce — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ===================================================================

# Database (PostgreSQL 16)
POSTGRES_DB=db
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpasswd
POSTGRES_PORT=5432

# Keycloak Identity Server (24+)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# Application Ports (Fullstack Profile)
API_PORT=8080
WEB_PORT=4200

